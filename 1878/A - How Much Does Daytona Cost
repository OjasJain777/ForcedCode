#include <bits/stdc++.h>
using namespace std;
 
int main() {
	int n;
	cin >>n;
	while(n--){
	    int m, k;
	    cin >>m >>k;
	    bool b=0;
	    while(m--){
	        int c;
	        cin>>c;
	        if(c==k){
	            b=1;
	        }
	    }
